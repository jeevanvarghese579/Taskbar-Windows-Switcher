<Window x:Class="TaskbarDesktopSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskbarDesktopSwitcher"
        mc:Ignorable="d"
        Title="Taskbar Desktop Switcher"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Taskbar Desktop Switcher"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#1A1A1A"/>
            <TextBlock Text="Switch virtual desktops with mouse wheel over taskbar"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Status Indicator -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusIndicator"
                         Width="12"
                         Height="12"
                         Fill="#4CAF50"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Status"
                               FontSize="12"
                               Foreground="#999999"/>
                    <TextBlock x:Name="StatusText"
                               Text="Running"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Start with Windows Toggle -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start with Windows"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <TextBlock Text="Automatically start the app when you log in"
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="StartWithWindowsToggle"
                              Grid.Column="1"
                              Width="50"
                              Height="26"
                              Checked="StartWithWindowsToggle_Checked"
                              Unchecked="StartWithWindowsToggle_Unchecked">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#CCCCCC"
                                                CornerRadius="13"
                                                Width="50"
                                                Height="26">
                                            <Ellipse x:Name="Ellipse"
                                                     Fill="White"
                                                     Width="20"
                                                     Height="20"
                                                     HorizontalAlignment="Left"
                                                     Margin="3,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                                <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Ellipse" Property="Margin" Value="0,0,3,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- About Button -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="20">
            <Button x:Name="AboutButton"
                    Content="About"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="AboutButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#106EBE"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#005A9E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

    </Grid>
</Window>